#!name = YouTube 去广告
#!desc = 去除 YouTube App 与网页版（Safari）广告，可选后台播放、字幕翻译（简体中文 zh-CN / 美式英语 en-US，仅翻译已有字幕）、隐藏首页 Shorts、屏蔽频道。视频流量不再经过 MITM，减少打开视频时的卡顿。需开启 MITM 并信任证书。
#!openUrl = https://github.com/imthnio/loon-youtube
#!author = imthnio
#!tag = YouTube, 去广告
#!loon_version = 3.5.1(983)
#!homepage = https://github.com/imthnio/loon-youtube
#!icon = https://raw.githubusercontent.com/imthnio/loon-youtube/main/App-Icons/youtube.png
#!date = 2026-10-09

[Argument]
background_playback = switch,false,tag=后台播放,desc=切换 App 或锁屏后普通视频继续播放声音。直播和受限内容仍由 YouTube 决定
playback_region = select,"original","CN","HK","TW","US","JP","KR","SG","GB","DE","RU",tag=播放请求地区,desc=original 为保持当前地区。只修改 YouTube App 请求里的 gl 参数，出口 IP 不变，对去广告的影响尚待验证
translation_enabled = switch,false,tag=字幕翻译,desc=把已有字幕翻译成下方选择的目标语言。关闭时保持原字幕请求
translation_target = select,"zh-CN","en-US",tag=字幕目标语言,desc=只转换已有字幕轨（zh-CN 简体中文 / en-US 美式英语）。没有字幕的视频无法翻译，音轨、标题和简介不变
hide_home_shorts = switch,false,tag=隐藏首页 Shorts,desc=移除首页信息流中的 Shorts 栏。底部 Shorts 标签和其他页面保留
blocked_channels = input,"",tag=屏蔽频道,desc=填写频道 ID、@handle 或完整频道名，多个用空格分隔。建议用频道 ID，名称含空格时请改用 handle 或 ID。留空即关闭，只隐藏能识别出作者的视频
blocked_channels_url = input,"",tag=远程屏蔽频道列表,desc=公开的 HTTPS 纯文本直链（如 GitHub Raw）。本地缓存每小时刷新，也可手动运行更新脚本，与上方手动列表合并。留空即关闭
log_enabled = switch,false,tag=日志工具,desc=开启后在第一次命中请求时自动开始记录，并通知日志入口。关闭后下一次接口命中会清空日志并停止记录，需要的话请先下载
log_level = select,"info","debug","warn","error",tag=日志级别,desc=info 保留完整（已脱敏）记录；debug 保留调试级别；warn 保留警告和错误；error 只保留错误
capture_budget = select,"32","16","64",tag=日志容量（MB）,desc=达到上限后停止记录，已有记录保留。导出后请清空

[Rule]
# API 和网页走 QUIC 时 Loon 无法解密，拒绝 UDP 443 让其回落到 TCP，脚本才能生效
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
# 视频流 QUIC 立即回落 TCP，避免经代理时 UDP 不通导致等待
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
# 网页版（Safari）的 ad_break 返回空 JSON；网页播放器只认 JSON，不能返回 protobuf
^https:\/\/(?:www\.|m\.|music\.)?youtube\.com\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$ reject-dict

[Script]
# 定时刷新远程屏蔽频道缓存，信息流脚本只读缓存，不等待下载
cron "0 * * * *" script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,timeout=10,argument=[{blocked_channels_url}],tag=YouTube 定时更新屏蔽频道
generic script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,timeout=10,argument=[{blocked_channels_url}],tag=YouTube 立即更新屏蔽频道,img-url=person.crop.circle.badge.xmark.system

# 字幕翻译
http-request ^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,requires-body=false,timeout=10,enable={translation_enabled},argument=[{translation_enabled},{translation_target}],tag=YouTube 字幕翻译

# 日志工具（只读请求头，不缓冲视频）
http-request ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,requires-body=false,timeout=10,enable={log_enabled},argument=[{log_enabled},{log_level},{capture_budget},{background_playback}],tag=YouTube 日志与导出

# 以下两条只对 YouTube App 有效（脚本内部只处理 App 的 protobuf），限定 App 的接口域名，网页版不再被缓冲
# log_event 请求只改请求头，不需要读取请求体
http-request ^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/log_event(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,requires-body=false,timeout=10,argument=[{log_enabled},{log_level},{capture_budget}],tag=YouTube App 配置请求处理
http-response ^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget}],tag=YouTube App 配置缓存

# 播放请求：App 的播放地区与 ad_break 处理
http-request ^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(?:player|get_watch|player\/ad_break)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/request.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{playback_region}],tag=YouTube App 播放请求与广告配置

# 信息流广告、首页 Shorts、屏蔽频道（App 与网页版）
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{hide_home_shorts},{blocked_channels},{blocked_channels_url}],tag=YouTube 信息流去广告与首页 Shorts

# 播放页广告与后台播放（App 与网页版）
http-response ^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch|reel\/reel_watch_sequence)(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/imthnio/loon-youtube/main/Scripts/YouTube/response.min.js,requires-body=true,binary-body-mode=true,timeout=10,argument=[{log_enabled},{log_level},{capture_budget},{background_playback}],tag=YouTube 播放去广告与后台播放

[Mitm]
# 不解密 *.googlevideo.com：视频分片不再经过 Loon 解密/重新加密，这是 Safari 打开视频前几秒卡顿的主要原因
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com
